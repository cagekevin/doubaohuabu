{
  "name": "doubao-canvas-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "豆包画布 · 渲染层（TS/TSX 重写）。宿主能力经 HostPort 抽象，默认不依赖 Electron。",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "lint:invariants": "node scripts/check-invariants.cjs",
    "lint:host-api": "node scripts/check-host-api.cjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries && npm run lint:invariants && npm run lint:host-api && npm run test",
    "spec:ui": "node scripts/ui-spec/extract-ui-inventory.cjs && node scripts/ui-spec/gen-ui-spec.cjs",
    "census:ssot": "node scripts/census-ssot.cjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "classic-level": "^3.0.0",
    "dependency-cruiser": "^18.5.0",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
