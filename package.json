{
  "name": "doubao-canvas-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "豆包画布 · 渲染层（TS/TSX 重写）。宿主能力经 HostPort 抽象，默认不依赖 Electron。",
  "author": "豆包画布",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "lint:dead-code": "node scripts/check-dead-code.mjs",
    "lint:gates": "node scripts/check-gate-vitals.mjs",
    "test": "vitest run",
    "check": "node scripts/gates-run.mjs check",
    "check:health": "node scripts/gates-run.mjs health",
    "check:list": "node scripts/gates-run.mjs list",
    "gate:status": "node scripts/gates-run.mjs status",
    "gate:off": "node scripts/gates-run.mjs off",
    "gate:on": "node scripts/gates-run.mjs on",
    "spec:ui": "node scripts/ui-spec/extract-ui-inventory.cjs && node scripts/ui-spec/gen-ui-spec.cjs",
    "census:ssot": "node scripts/census-ssot.cjs",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File packing/icon.ps1 -Source \"画布网站图标.png\"",
    "pack:win": "npm run build && electron-builder --win --config packing/win/electron-builder.yml",
    "pack:dir": "npm run build && electron-builder --win --dir --config packing/win/electron-builder.yml",
    "pack:mac": "npm run build && electron-builder --mac --config packing/mac/electron-builder.yml"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "classic-level": "^3.0.0",
    "dependency-cruiser": "^18.5.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
