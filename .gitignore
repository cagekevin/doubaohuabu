# ── 依赖 ──
node_modules/

# ── 构建产物 ──
dist/
# ── 后端（宿主壳）TS 迁移：生成物 / 备份 / 增量缓存 ──
#   build/ = 声明层产物（@shared/* 的落点，每次构建重生成）
#   .migration-backup/ = 迁移脚本改源文件前的自备份（本仓 git 不是安全网，见该目录 弯路.md W1）
build/
.migration-backup/
*.tsbuildinfo
# ── 迁移任务的证据区（快照 / 黄金样本 / 数据兼容样本）：是证据、不是第二种真源 ──
docs/plan/后端TS迁移/evidence/

# ── 原版参考 · 脚本产出（inputs/ 与 scripts/ 才是源，outputs/ 一律脚本生成）──
docs/豆包画布原版参考/outputs/

# ── 探针 / 临时产物（不变量检查的 journal）──
.probe/

# ── 环境变量 ──
.env
.env.*
!.env.example

# ── 截图产物（docs/mockup 预览截图，脚本生成）──
.shots/

# ── 日志（仅 npm 侧；勿用 *.log —— leveldb fixture 有 000014.log / LOG.old）──
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
